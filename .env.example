# ==========================================
# 🔑 LLM API KEYS
# ==========================================
# Lấy API Key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# (Tùy chọn) OpenAI API Key nếu có sử dụng
OPENAI_API_KEY=your_openai_api_key_here

# ==========================================
# ⚙️ BACKEND API CONFIGURATION (FastAPI)
# ==========================================
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development

# ==========================================
# 🤖 MODEL ARTIFACT PATHS
# ==========================================
MODEL_PATH=source/model/classifier/saved_models/best_model.joblib
VECTORIZER_PATH=source/model/classifier/saved_models/tfidf_vectorizer.joblib

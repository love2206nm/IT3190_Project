# ==========================================
# 🐍 Python Bytecode & Cache
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec

# ==========================================
# 🌐 Virtual Environments (Môi trường ảo)
# ==========================================
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ==========================================
# 🔑 Environment Variables & API Keys (Bảo mật)
# ==========================================
.env
.env.local
.env.*
!.env.example

# ==========================================
# 🧪 Testing & Code Quality Caches
# ==========================================
.pytest_cache/
.ruff_cache/
.mypy_cache/
.importlinter_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
junit.xml

# ==========================================
# 📓 Jupyter Notebooks (File checkpoint tạm)
# ==========================================
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# ==========================================
# 🤖 Machine Learning Models & Heavy Artifacts
# ==========================================
# Không commit file model weights nặng lên Git
*.joblib
*.pkl
*.pickle
*.onnx
*.pt
*.pth
*.bin
*.h5
source/model/classifier/saved_models/*
!source/model/classifier/saved_models/.gitkeep
!source/model/classifier/saved_models/best_model.joblib
!source/model/classifier/saved_models/tfidf_vectorizer.joblib
!source/model/classifier/saved_models/label_mapping.json

# ==========================================
# 📊 Processed Data (Dữ liệu sinh ra)
# ==========================================
data/clean_data/*
!data/clean_data/.gitkeep

# ==========================================
# 💻 IDE & Text Editors
# ==========================================
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ==========================================
# 🖥️ OS Generated Files (Windows / Mac)
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ==========================================
# 📝 Logs & Temporary Files
# ==========================================
*.log
logs/*
!logs/.gitkeep
tmp/
temp/

# ==========================================
# 🐳 Docker & Deploy Caches
# ==========================================
.docker/
node_modules/
npm-debug.log*
